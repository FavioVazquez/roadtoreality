# Ignore everything by default
*

# Allow only what belongs in the repo
!.gitignore
!.nojekyll
!CNAME
!README.md
!index.html
!.planning/
!.planning/**
!docs/
!docs/**
!HowPhysicsWorks/
!HowPhysicsWorks/**
!scripts/
!scripts/**
!assets/
!assets/**

!remeasured/
!remeasured/**

!package.json
!package-lock.json
node_modules/

# Always exclude secrets and caches even inside allowed folders
.env
**/__pycache__/
**/*.pyc
**/*.pyo
**/.DS_Store

# Road re-measured: never commit raw data (re-download scripts + checksums instead)
remeasured/**/data/
remeasured/**/*.hdf5
remeasured/**/*.gwf
remeasured/**/*.h5
remeasured/**/scans/

# Road re-measured: large run products stay local (checksums in out/CHECKSUMS_outputs.tsv)
remeasured/**/*.nc
remeasured/**/*_posterior.npz
remeasured/**/partA_area_samples.npz
